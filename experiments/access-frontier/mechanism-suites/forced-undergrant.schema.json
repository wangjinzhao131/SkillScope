{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skillscope.local/schemas/forced-undergrant-suite.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "suiteId", "description", "estimand", "arms", "probes"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "1.0"},
    "suiteId": {"const": "forced-undergrant-r1"},
    "description": {"type": "string", "minLength": 1},
    "estimand": {"type": "string", "minLength": 1},
    "arms": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "allowResourceRequest", "freshRerunAfterApproval"],
        "properties": {
          "id": {"enum": ["FORCED_UNDERGRANT_NO_EXPANSION", "FORCED_UNDERGRANT_NEED_RESOURCE"]},
          "allowResourceRequest": {"type": "boolean"},
          "freshRerunAfterApproval": {"type": "boolean"}
        }
      }
    },
    "probes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "initialGrants", "withheldRequiredEvidence", "requestEnvelope"],
        "properties": {
          "taskId": {"type": "string", "pattern": "^af-[a-z0-9-]+$"},
          "initialGrants": {"$ref": "#/$defs/grants"},
          "withheldRequiredEvidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/path"}
          },
          "requestEnvelope": {"$ref": "#/$defs/grants"}
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "kind", "operations"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "kind": {"enum": ["file", "directory"]},
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["read", "list", "search"]}
        }
      }
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/grant"}
    }
  }
}
