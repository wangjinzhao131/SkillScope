      "evidence": [
        {"shard": 6, "file": "health.log", "content": "gate=service-ready region=blue\ndeployment=d-204 observed_sha=sha-7f2 result=HEALTH_REJECTED\n", "startLine": 2, "endLine": 2, "contains": "observed_sha=sha-7f2", "claim": "The rejected deployment was running sha-7f2."},
        {"shard": 11, "file": "release.cfg", "content": "service=payments\ncurrent_sha=sha-9c1 healthy=true\nprevious_sha=sha-7f2 retired=true\n", "startLine": 2, "endLine": 3, "contains": "current_sha=sha-9c1", "claim": "sha-9c1 is current and sha-7f2 is retired."}
      ]
    },
    {
