        "deploymentId": {"type": "string", "pattern": "^d-[0-9]+$"},
        "observedSha": {"type": "string", "pattern": "^sha-[0-9a-f]+$"},
        "currentSha": {"type": "string", "pattern": "^sha-[0-9a-f]+$"}
