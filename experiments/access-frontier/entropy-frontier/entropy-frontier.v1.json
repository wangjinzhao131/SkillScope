    {
      "id": "af-entropy-signing-v2",
      "pairId": "pair-entropy-signing-v2",
      "title": "Opaque signing-key archive",
      "goal": "Diagnose why request r-830 was rejected after a signing-key rotation. Return the answerCode and all necessary evidence paths.",
      "prompt": "request=r-830\nsymptom=signature rejected after key rotation\n",
      "promptPath": "tickets/r-830.txt",
      "answerCode": "STALE_SIGNING_KEY",
      "answerCandidates": ["INSUFFICIENT_EVIDENCE", "INVALID_SIGNATURE_PAYLOAD", "STALE_SIGNING_KEY", "VERIFIER_UNAVAILABLE"],
      "facts": {"requestId": "r-830", "usedKey": "k-58", "activeKey": "k-61"},
      "factProperties": {
        "requestId": {"type": "string", "pattern": "^r-[0-9]+$"},
        "usedKey": {"type": "string", "pattern": "^k-[0-9]+$"},
        "activeKey": {"type": "string", "pattern": "^k-[0-9]+$"}
      },
      "evidence": [
        {"shard": 3, "file": "events.log", "content": "verifier=edge-4 batch=rotate-12\nrequest=r-830 result=SIGNATURE_REJECTED key_id=k-58\n", "startLine": 2, "endLine": 2, "contains": "SIGNATURE_REJECTED key_id=k-58", "claim": "The rejected request used signing key k-58."},
        {"shard": 14, "file": "runtime.cfg", "content": "region=edge\nactive_key_id=k-61\nprevious_key_id=k-58 retired=true\n", "startLine": 2, "endLine": 3, "contains": "active_key_id=k-61", "claim": "The active key is k-61 and k-58 is retired."}
      ]
    },
    {
      "id": "af-entropy-release-v2",
