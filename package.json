{
  "name": "pi-scoped-skills",
  "version": "0.1.0",
  "description": "A bounded, observable scoped-skill runtime for Pi.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "scoped-skills",
    "agent-runtime"
  ],
  "files": [
    "src",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run test:core && npm run test:pi && npm run test:parent-context && npm run test:composition && npm run test:fixtures && npm run test:experiment && npm run test:mechanism && npm run test:entropy && npm run test:resource-set && npm run test:analysis && npm run test:plugin-audit && npm run test:security",
    "test:core": "node --test tests/core/**/*.test.js",
    "test:pi": "node --test tests/pi/**/*.test.js",
    "test:parent-context": "node --test experiments/parent-context/src/*.test.mjs && node experiments/parent-context/src/cli.mjs --smoke",
    "test:composition": "node --test experiments/composition-topology/src/*.test.mjs && node experiments/composition-topology/src/cli.mjs --smoke",
    "test:fixtures": "node --test experiments/access-frontier/tasks/*.test.mjs && node experiments/access-frontier/tasks/lint.mjs",
    "test:experiment": "node --test experiments/access-frontier/src/runner.test.mjs tests/experiment-audit/*.test.mjs",
    "test:mechanism": "node --test experiments/access-frontier/mechanism-suites/*.test.mjs && node experiments/access-frontier/mechanism-suites/lint.mjs && node experiments/access-frontier/mechanism-suites/executor.mjs --smoke",
    "test:entropy": "node --test experiments/access-frontier/entropy-frontier/*.test.mjs",
    "test:resource-set": "node --test experiments/access-frontier/resource-set-holdout/*.test.mjs && node experiments/access-frontier/resource-set-holdout/executor.mjs --smoke",
    "test:analysis": "python3 -m unittest discover -s experiments/access-frontier/analysis/tests -p 'test_*.py'",
    "test:plugin-audit": "node --test tests/plugin-audit/*.test.js",
    "test:security": "node scripts/security/run.mjs",
    "verify": "npm run typecheck && npm test && npm pack --dry-run",
    "experiment:smoke": "node experiments/access-frontier/src/cli.mjs --smoke",
    "experiment:run": "node experiments/access-frontier/src/cli.mjs",
    "experiment:analyze": "python3 experiments/access-frontier/analysis/analyze.py",
    "parent-context:smoke": "node experiments/parent-context/src/cli.mjs --smoke",
    "parent-context:preflight": "node experiments/parent-context/src/cli.mjs --preflight",
    "parent-context:plan": "node experiments/parent-context/src/cli.mjs --plan experiments/parent-context/runs/manifest.json",
    "parent-context:run": "node experiments/parent-context/src/cli.mjs --run --manifest experiments/parent-context/runs/manifest.json --results experiments/parent-context/runs/results.jsonl --concurrency 1",
    "parent-context:analyze": "node experiments/parent-context/src/cli.mjs --analyze --manifest experiments/parent-context/runs/manifest.json --results experiments/parent-context/runs/results.jsonl --output experiments/parent-context/reports/latest",
    "composition:smoke": "node experiments/composition-topology/src/cli.mjs --smoke",
    "composition:preflight": "node experiments/composition-topology/src/cli.mjs --preflight",
    "composition:plan": "node experiments/composition-topology/src/cli.mjs --plan experiments/composition-topology/runs/manifest.json",
    "composition:run": "node experiments/composition-topology/src/cli.mjs --run --manifest experiments/composition-topology/runs/manifest.json --results experiments/composition-topology/runs/results.jsonl --concurrency 1",
    "composition:analyze": "node experiments/composition-topology/src/cli.mjs --analyze --manifest experiments/composition-topology/runs/manifest.json --results experiments/composition-topology/runs/results.jsonl --output experiments/composition-topology/reports/latest"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "26.2.0",
    "typebox": "1.3.7",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "yaml": "2.9.0"
  },
  "pi": {
    "extensions": [
      "./src/pi/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
